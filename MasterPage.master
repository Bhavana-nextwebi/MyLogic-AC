    <style>
        .highlight-phone{
            background: #0c5397;
    color: white;
    padding: 12px 14px;
    border-radius: 15px;
        }
        .whats-icon {
    width: 64px;
    height: 64px;
}
        .scroll__top {
    position:fixed !important;
    display: -webkit-box;
    display: -moz-box;
    display: -ms-flexbox;
    display: -webkit-flex;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 62px !important;
    height: 62px !important;
    position: fixed;
   /* bottom: 10%;*/
    right: 18px;
    font-size: 16px;
    border-radius: 50px;
    z-index: 99;
    color: var(--tg-common-color-white);
    text-align: center;
    cursor: pointer;
    background: var(--tg-theme-primary) !important;
    transition: 1s ease;
    border: none;
    left: 11px;
    top: 81%;
    padding: 12px;
}
       
        .whatsapp-btn {
    position: fixed;
    bottom: 10PX;
    background:none !important;
    color: #fff;
    text-decoration: none;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: nowrap;
    gap: 8px;
    padding:0px !important;
    font-weight: 600;
    box-shadow: 0 -2px 8px rgba(0, 0, 0, 0.2);
    z-index: 9999;
    transition: background 0.2s ease-in-out;
    text-align: center;
    padding:0px !important;
    width:60px !important;
    border-radius: 8px;
    left: 4%;
}
.whats-icon {
    width: 64px;
    height: 64px;
}
@media (max-width: 768px) {
    .scroll__top {
        top: auto;       /* Remove fixed top */
        bottom: 80px;    /* Position above WhatsApp button */
        right: 18px;
    }

    .whatsapp-btn {
        bottom: 10px;    /* Keep at the bottom */
    }
}


.popup-overlay{
    position:fixed;
    top:0;
    left:0;
    width:100%;
    height:100%;
    background:rgba(0,0,0,0.65);
    display:none;
    justify-content:center;
    align-items:center;
    z-index:9999;
}

.popup-container{
    width:420px;
    background:#0d2b4c;
    padding:30px;
    border-radius:10px;
    text-align:center;
    color:white;
    position:relative;
}

.popup-container h2{
    color:#ffc107;
    margin-bottom:8px;
}

.popup-subtitle{
    font-size:14px;
    margin-bottom:20px;
}

.popup-input{
    width:100%;
    padding:10px;
    margin-bottom:10px;
    border-radius:5px;
    border:none;
}

.popup-btn{
    width:100%;
    padding:12px;
    background:#3b82f6;
    border:none;
    border-radius:25px;
    color:white;
    font-weight:600;
    cursor:pointer;
}

.popup-close{
    position:absolute;
    top:10px;
    right:15px;
    font-size:20px;
    cursor:pointer;
}

.success-popup{
    position: fixed;
    bottom: 30px;
    right: 30px;
    background: #28a745;
    color: #fff;
    padding: 15px 20px;
    border-radius: 6px;
    display: none;
    z-index: 9999;
}
.popup-subtitle {
    font-size: 14px;
    margin-bottom: 20px;
    color: white;
}

.hidden{
    display:none;
}
    </style>
