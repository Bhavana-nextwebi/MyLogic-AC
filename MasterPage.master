</script>
    <script>
  document.addEventListener("DOMContentLoaded", function () {

    if (!sessionStorage.getItem("formSubmitted")) {

        setTimeout(function () {

            var popup = document.getElementById("enquiryPopup");

            if (popup) {
                popup.style.display = "flex";
            }

        }, 5000);

    }

    // hide error when user types
    document.querySelectorAll(".popup-input").forEach(function (input) {
        input.addEventListener("input", function () {
            document.getElementById("error").classList.add("hidden");
        });
    });

});


function closePopup() {

    var popup = document.getElementById("enquiryPopup");

    if (popup) {
        popup.style.display = "none";
    }

}


function showError(message) {

    var error = document.getElementById("error");

    error.textContent = message;
    error.classList.remove("hidden");
    error.style.color = "red";

}


function validateForm() {

    var name = document.getElementById("txtName1").value.trim();
    var phone = document.getElementById("txtPhone1").value.trim();
    var email = document.getElementById("txtEmail1").value.trim();

    if (name === "") {
        showError("Please enter your name");
        document.getElementById("txtName1").focus();
        return false;
    }

    if (!/^[A-Za-z ]+$/.test(name)) {
        showError("Name should contain only letters");
        document.getElementById("txtName1").focus();
        return false;
    }

    if (phone === "") {
        showError("Please enter phone number");
        document.getElementById("txtPhone1").focus();
        return false;
    }

    if (!/^[0-9]{10,15}$/.test(phone)) {
        showError("Phone number must be 10-15 digits");
        document.getElementById("txtPhone1").focus();
        return false;
    }

    if (email === "") {
        showError("Please enter email");
        document.getElementById("txtEmail1").focus();
        return false;
    }

    if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
        showError("Enter a valid email");
        document.getElementById("txtEmail1").focus();
        return false;
    }

    return true;

}


function submitForm() {

    if (!validateForm()) {
        return;
    }

    var btn = document.getElementById("popup-btn");

    btn.innerHTML = "Please Wait...";
    btn.disabled = true;

    var name = document.getElementById("txtName1").value.trim();
    var phone = document.getElementById("txtPhone1").value.trim();
    var email = document.getElementById("txtEmail1").value.trim();

    var currentURL = window.location.href;

    $.ajax({

        type: "POST",
        url: "/Default.aspx/GetEnquiry",

        data: JSON.stringify({
            name: name,
            email: email,
            course_name: "",
            Mode: "",
            contact: phone,
            currentURL: currentURL
        }),

        contentType: "application/json; charset=utf-8",
        dataType: "json",

        success: function (res) {

            if (res.d === "Success") {

                sessionStorage.setItem("formSubmitted", "yes");

                window.location.href = "thank-you.aspx";

            } else {

                showError(res.d);

                btn.innerHTML = "Book My FREE Demo Session";
                btn.disabled = false;
            }

        },

        error: function () {

            showError("Server error. Please try again.");

            btn.innerHTML = "Book My FREE Demo Session";
            btn.disabled = false;

        }

    });

        }
</script>
