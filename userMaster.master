    <style>
        .course-text h2 {
            width: 190px;
            text-align: center;
            font-weight: var(--fw-600);
            text-transform: uppercase;
        }

        button.btn-close {
            position: absolute;
            right: 40px;
            top: 40px;
        }

            button.btn-close i {
                color: #fff;
                opacity: 1;
            }

        button.btn-close {
            opacity: 1;
        }

        .btn-close {
            --bs-btn-close-color: #fff;
            --bs-btn-close-bg: unset !important;
        }

        .modal-content {
            border-radius: 6px;
        }

        ul.d-lg-none.d-block.new-flex {
            display: flex !important;
            gap: 1rem;
            margin: 10px 10px;
        }

        .modal-body {
            z-index: 1;
            padding: 40px 40px;
            background: #e94367;
        }

        .modal-title {
            font-size: 22px;
            color: #fff;
        }

        .new-flex {
            padding: 20px 10px;
        }

            .new-flex a {
                box-shadow: none;
                color: #fff !important;
                text-align: center !important;
            }

                .new-flex a.btn.btn-outline {
                    border: 2px solid #000;
                    background: #000;
                }

        .tgmobile__menu .navigation li ul.new-flex li > a {
            margin-left: 0px !important;
            padding: 10px 25px !important;
        }

        .new-flex li {
            border-top: unset !important;
        }

        .dashboard__top-bg {
            min-height: 200px;
        }

        .dashboard__area {
            margin-top: 120px !important;
        }

        .ftr-list li:last-child a::after {
            content: none;
            display: none;
        }
    </style>
    <asp:ContentPlaceHolder ID="head" runat="server">
    </asp:ContentPlaceHolder>
